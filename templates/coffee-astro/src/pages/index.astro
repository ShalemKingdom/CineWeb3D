---
import '../styles.css';
import '../../../../src/style.css';
import {buildSeo,jsonLd} from '../../../../src/modules/seo.js';
const seo=buildSeo({siteUrl:process.env.SITE_URL,indexable:process.env.SITE_INDEXABLE==='true'});
const schema=seo.canonical?jsonLd({'@context':'https://schema.org','@type':'WebPage',name:seo.title,description:seo.description,url:seo.canonical}):null;
const socialImage=process.env.SOCIAL_IMAGE_URL?new URL(process.env.SOCIAL_IMAGE_URL):null;
if(socialImage&&socialImage.protocol!=='https:')throw Error('Social image must be HTTPS');
---
<!doctype html><html lang={seo.locale}><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>{seo.title}</title><meta name="description" content={seo.description}><meta name="robots" content={seo.robots}><meta property="og:type" content="website"><meta property="og:title" content={seo.title}><meta property="og:description" content={seo.description}><meta name="twitter:card" content="summary"><meta name="twitter:title" content={seo.title}><meta name="theme-color" content="#20160f"><link rel="icon" href="/coffee-poster.svg" type="image/svg+xml">{seo.canonical&&<link rel="canonical" href={seo.canonical}/>}{seo.canonical&&<meta property="og:url" content={seo.canonical}/>}{socialImage&&<meta property="og:image" content={socialImage.href}/>}{socialImage&&<meta name="twitter:image" content={socialImage.href}/>}{schema&&<script type="application/ld+json" set:html={schema} is:inline />}</head><body><a class="skip" href="#content">Skip to content</a><header class="site-header mx-auto max-w-[100rem]"><a class="brand" href="#content">CineWeb3D</a><nav aria-label="Main navigation"><a href="#experience">Experience</a><a href="#project">Project</a></nav><div class="mode"><label for="quality">Visual quality</label><select id="quality"><option value="auto">Auto</option><option value="cinematic">Cinematic</option><option value="balanced">Balanced</option><option value="lite">Lite</option><option value="accessible">Accessible / static</option></select></div></header>
<main id="content"><section class="hero" aria-labelledby="hero-title"><div class="copy"><p class="eyebrow">Open-source cinematic web toolkit</p><h1 id="hero-title">Coffee, in motion.</h1><p>Explore a three-dimensional coffee experience with cinematic camera movements and scroll-driven animation.</p><a class="cta" href="#experience">Explore the experience</a><p class="note" id="quality-status" role="status">Static illustration available.</p></div><figure class="poster" id="scene-poster"><img src="/coffee-poster.svg" width="800" height="640" alt="Illustrated ceramic coffee cup with rising steam" fetchpriority="high"><figcaption>Original illustrative coffee concept.</figcaption></figure><canvas id="scene" hidden aria-hidden="true"></canvas></section>
<section id="experience" class="chapter" aria-labelledby="experience-title"><div class="copy"><p class="eyebrow">01 · The experience</p><h2 id="experience-title">Crafted in 3D.</h2><p>Scroll to explore the cup, camera and separated handle. The experience is also available as readable content without WebGL or animation.</p><a href="#project">Discover the toolkit</a></div></section>
<section id="project" class="chapter"><div class="copy"><p class="eyebrow">02 · The toolkit</p><h2>Made for the web.</h2><p>Three.js, Anime.js and Lenis power an experimental toolkit for cinematic sites. This is a demonstration, not a live coffee shop or online store.</p><a class="cta" href="https://github.com/ShalemKingdom/cineweb3d">Explore the GitHub project</a></div></section></main><footer><p>CineWeb3D · Experimental demo · <a href="#content">Back to top</a></p></footer><script>import '../../../../src/bootstrap.js';</script></body></html>
