{
  "name": "cineweb3d",
  "version": "0.6.0-alpha.9",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run components:check && vite build && node scripts/build-seo.mjs && node scripts/distribution-notices.mjs vite",
    "preview": "vite preview",
    "media:check": "python3 scripts/check_media.py",
    "test": "node --test tests/*.test.js",
    "doctor": "python3 scripts/check_media.py",
    "test:e2e": "playwright test",
    "quality": "lhci autorun",
    "images:optimize": "node scripts/optimize-images.mjs",
    "dev:astro": "npm --prefix templates/coffee-astro run dev",
    "build:astro": "npm --prefix templates/coffee-astro run build && node scripts/build-astro-seo.mjs && node scripts/distribution-notices.mjs astro",
    "blender:check": "python3 scripts/blender_bridge.py --dry-run",
    "blender:build": "python3 scripts/blender_bridge.py",
    "blender:publish": "node scripts/smart-assets.mjs publish",
    "test:blender": "python3 -m unittest discover -s tests -p test_blender_bridge.py",
    "assets:setup": "npm --prefix tools/assets install",
    "assets:inspect": "node scripts/smart-assets.mjs inspect",
    "assets:validate": "node scripts/smart-assets.mjs validate",
    "assets:optimize": "node scripts/smart-assets.mjs optimize",
    "video:optimize": "python3 scripts/smart_video.py",
    "test:video": "python3 -m unittest discover -s tests -p test_smart_video.py",
    "diagnostics:assets": "node scripts/diagnose-assets.mjs",
    "components:generate": "node scripts/generate-commercial.mjs",
    "components:check": "node scripts/generate-commercial.mjs --check",
    "multimedia:check": "python3 scripts/ai_multimedia.py check",
    "multimedia:run": "python3 scripts/ai_multimedia.py",
    "test:multimedia": "python3 -m unittest discover -s tests -p test_ai_multimedia.py",
    "release:check": "node scripts/release-check.mjs",
    "test:python": "python3 -m unittest discover -s tests -p 'test_*.py'",
    "validate:local": "npm test && npm run test:python && npm run components:check && npm run diagnostics:assets -- public --strict && npm run director:check && npm run community:check",
    "security:check": "node scripts/security-shield.mjs",
    "security:stable": "node scripts/security-shield.mjs --stable",
    "seo:check": "node scripts/seo-shield.mjs",
    "quality:production": "lhci autorun --config=lighthouserc.production.cjs",
    "director:plan": "node scripts/director-plan.mjs",
    "director:check": "node scripts/check-skill.mjs",
    "setup": "node scripts/setup.mjs",
    "community:check": "node scripts/check-community.mjs"
  },
  "dependencies": {
    "animejs": "^4.2.0",
    "lenis": "^1.3.0",
    "three": "^0.181.2",
    "web-vitals": "^5.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@lhci/cli": "^0.16.1",
    "@playwright/test": "^1.55.0",
    "sharp": "^0.35.5",
    "vite": "^7.3.8"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "lighthouse": "13.5.0"
  }
}
